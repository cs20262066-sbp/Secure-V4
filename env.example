# Copy to .env for local runs. On Render: set these in the dashboard (Environment).

# Required in production — signs session cookies
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# First admin (created once on startup if email does not exist)
ADMIN_EMAIL=
ADMIN_PASSWORD=

DEBUG=False
API_PORT=5000
ALLOWED_ORIGINS=*

# Site authorized for active (owned-app) scanning only
MONITORED_ASSET=https://example.com

# Persistence — required for auth, admin, recon
USE_DATABASE=True

# Local default:
# DATABASE_URL=sqlite:///secure.db
# Render: leave unset and attach a PostgreSQL database, or paste the Internal Database URL
DATABASE_URL=sqlite:///secure.db

DEFAULT_SCAN_INTERVAL_SECONDS=60

# Optional external APIs (recon still works without them)
SHODAN_API_KEY=
CENSYS_API_ID=
CENSYS_API_SECRET=
HUNTER_API_KEY=

# Set true only if eventlet causes issues
DISABLE_EVENTLET=False
